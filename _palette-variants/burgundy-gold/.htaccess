# SkyWings Aviation Academy — static Next.js export
# Prefer our static pages over any leftover CMS index files
DirectoryIndex index.html index.php

ErrorDocument 404 /404.html

# ── 301 redirects: old WordPress URLs ──
RedirectMatch 301 ^/about/?$ /about-us/
RedirectMatch 301 ^/aviation-courses/?$ /aviation-courses-in-kerala/
RedirectMatch 301 ^/courses/?$ /aviation-courses-in-kerala/
RedirectMatch 301 ^/bba-airline-airport-management/?$ /bba-aviation/
RedirectMatch 301 ^/blogs-articles-aviation-hospitality/?$ /articles-and-news/
RedirectMatch 301 ^/blog/?$ /articles-and-news/
RedirectMatch 301 ^/skywings-aviation-college-kochi-campus/?$ /kochi-campus/
RedirectMatch 301 ^/skywings-aviation-college-mahe/?$ /mahe-campus/
RedirectMatch 301 ^/aviation-courses-in-kerala-2/?$ /aviation-courses-in-kerala/
RedirectMatch 301 ^/enquire-now/?$ /contact/
RedirectMatch 301 ^/home-copy/?$ /
RedirectMatch 301 ^/uncategorized/?$ /articles-and-news/
RedirectMatch 301 ^/design-branding/?$ /articles-and-news/
RedirectMatch 301 ^/business/?$ /articles-and-news/

