# Archive/system prefixes
RedirectMatch 301 ^/tag/.* /articles-and-news/
RedirectMatch 301 ^/category/.* /articles-and-news/
RedirectMatch 301 ^/type/.* /articles-and-news/
RedirectMatch 301 ^/author/.* /articles-and-news/
RedirectMatch 301 ^/elementor-hf/.* /
RedirectMatch 301 ^/wp-content/.* /
RedirectMatch 301 ^/wp-admin/.* /
RedirectMatch 301 ^/wp-json/.* /articles-and-news/

# ── Caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# hashed Next.js build assets are immutable
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
